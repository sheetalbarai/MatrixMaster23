<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Timeline</title>
    <link rel="stylesheet" type="text/css" href="./css/style.css">
</head>
<body>
    <div class="heading">
        <h1>Timeline</h1>
    </div>
    <div>
        <ul class ="msg_container">
       
            <% comments.forEach(comment => {%>
                <li>
                    <p class="msgName"><%=comment.name%> - <%=comment.createdAt%></p>
                    <p class="msgContent"><%=comment.message%></p>
                </li>
            <% }); %>
        </ul>
    </div>
    <footer></footer>
</body>
</html>

 