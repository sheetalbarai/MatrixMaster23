<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs')%>
<body>
    <%- include ('./partials/nav.ejs')%>
    <div class="container">
        <div class="seeAPost">
            <% if (post) { %>
                <li>
                    <p class="msgName"><%=post.name%> - <%=(post.createdAt).toDateString().slice(3)%></p>
                    <p class="msgContent"><%=post.message%></p>
                </li>
            <%} else {%>
                    <p> Error in the path to fetch a post  ....</p>
            <%} %>
            <div class="btns">
                <a href="/deletePost/<%=post._id%>"><button class="btn deletePost">Delete</button></a>
                <a href="/editPost/<%=post._id%>"><button class="btn editPost">Edit Post</button></a>
            </div>                   
        </div>
        
    </div>
    <%- include('./partials/footer.ejs'); %>
</body>
</html>