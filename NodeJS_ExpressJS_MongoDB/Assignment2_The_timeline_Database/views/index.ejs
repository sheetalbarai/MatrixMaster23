<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs')%>
<body>
    <%- include ('./partials/nav.ejs')%>
    <div class="container">
        <div class="newPost">
            <form action="./createNewPost" method="POST">
                <label>Name</label>
                <input class="newPostName" name="name" placeholder="Your Name">
                <lebel> Post a message</lebel>
                <textarea class="newPostText" name="message" placeholder="Start writing your Post"></textarea>
                <button class="newPostBtn">Post a message</button>
            </form>
        </div>
        <ul class ="msg_container">
                <% if (comments.length >0) { %>
                <% comments.forEach(comment => {%>
                    <li>
                        <p class="msgName"><%=comment.name%> - <%=(comment.createdAt).toDateString().slice(3)%></p>
                        <p class="msgContent"><%=comment.message%> <a href="./showAPost/<%=comment._id%>">See More</a></p>
                        
                    </li>
                <% }); %>
            <%} else {%>
                <p> No comments to display ....</p>
            <%} %>
        </ul>
    </div>
    <%- include('./partials/footer.ejs'); %>
</body>
</html>

 