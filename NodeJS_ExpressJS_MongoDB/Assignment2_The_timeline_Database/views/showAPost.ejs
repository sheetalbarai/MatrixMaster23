<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs')%>
<body>
    <%- include ('./partials/nav.ejs')%>
    <div class="container">
        <div class="seeAPost">
            <% if (comment) { %>
                <li>
                    <p class="msgName"><%=comment.name%> - <%=(comment.createdAt).toDateString().slice(3)%></p>
                    <p class="msgContent"><%=comment.message%></p>
                </li>
            <%} else {%>
                    <p> Error in the path to fetch a comment  ....</p>
            <%} %>
            <div class="btns">
                <a href="/deletePost/<%=comment._id%>"><button class="btn deletePost">Delete</button></a>
                <a href="/editPost/<%=comment._id%>"><button class="btn editPost">Edit Post</button></a>
            </div>                   
        </div>
        
    </div>
    <%- include('./partials/footer.ejs'); %>
</body>
</html>