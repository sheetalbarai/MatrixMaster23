<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NodeJS-Engines | <%= ttl %></title>
    <style>
        body{
            font-family: monospace;
            background-color:lightyellow;
            max-width: 1200px;
        }
        p, h1, h2, h3, h4, a, ul{
          
            margin: 0;
            padding: 0;
            text-decoration: none;
        }
        nav{
            display: flex;
            justify-content: space-between;
            text-transform: uppercase;
            border-bottom: 1px solid black;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        nav ul{
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        nav ul li{
            margin-left: 20px;
            list-style-type: none;
        }
        
    h3{
        text-transform: capitalize;
        margin-bottom: 10px;
    }
    .content{
        margin: 0 20px;
    }
    .create-blog form{
        max-width: 400px;
        margin: 0 auto;
    }
    .create-blog form label{
        display: block;
        margin-bottom: 5px;
    }
    .ceate-blog form input, 
    .create-blog form textarea{
        width: 100%;
        display: block;
        margin:20px 0;
        padding: 5px;
    }
    .create-blog label{
        font-weight: bold;  
    }
    .create-blog form input[type="submit"]{
        background-color: black;
        color: white;
        border: none;
        padding: 10px 20px;
        cursor:pointer;
    }
    footer{
        text-align: center;
        margin-top: 20px;
        padding: 10px 0;
        border-top: 1px solid black;
    }

    </style>
</head>